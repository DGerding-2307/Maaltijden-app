# Kopieer naar .env en vul in.

# Anthropic API-sleutel voor Claude (kan ook via Instellingen in de app)
ANTHROPIC_API_KEY=

# Optioneel: ander Claude-model (standaard claude-opus-5-5)
# CLAUDE_MODEL=claude-opus-5-5

# Optioneel: wachtwoord voor de app (HTTP Basic Auth, gebruikersnaam maakt niet uit).
# Aanbevolen als de server vanaf internet bereikbaar is.
# APP_PASSWORD=

# Optioneel
# PORT=3000
# DB_FILE=./data/maaltijden.db
# JUMBO_API_BASE=https://mobileapi.jumbo.com/v17
